#!/usr/bin/env bash
# llm-serve - avvia mlx_lm.server con un modello scelto
#
# Uso:
#   llm-serve <profile>         avvia il server in foreground
#   llm-serve list              elenca i profili
#
# I profili sono definiti in config/llm-dash.toml (single source of truth).
# Override: PORT=N llm-serve <profile>    THINK=true llm-serve <profile>

set -euo pipefail

# Resolve symlink to find _config.py in the same directory
SCRIPT_DIR="$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}")"
CONFIG_HELPER="$SCRIPT_DIR/_config.py"

PROFILE="${1:-build}"

case "$PROFILE" in
  list|ls|--list|-l)
    python3 "$CONFIG_HELPER" list
    exit 0
    ;;
esac

# Read profile config from TOML (outputs MODEL=, LABEL=, NOTE=, CHAT_ARGS=, PORT=)
# Save user PORT override before eval clobbers it
_USER_PORT="${PORT:-}"
PROFILE_CONFIG="$(python3 "$CONFIG_HELPER" profile "$PROFILE")" || exit 1
eval "$PROFILE_CONFIG"
PORT="${_USER_PORT:-$PORT}"

if [[ ! -d "$MODEL" ]]; then
  echo "ERROR: modello non trovato in $MODEL" >&2
  exit 1
fi

echo ">>> Profile:  $PROFILE"
echo ">>> Model:    $(basename "$MODEL")"
echo ">>> Port:     $PORT"
echo ">>> Thinking: $THINK"
echo ">>> Endpoint: http://127.0.0.1:$PORT/v1"
echo

ARGS=(
  --model "$MODEL"
  --host 127.0.0.1
  --port "$PORT"
  --log-level INFO
  --temp 0.0
  --max-tokens 8192
  --prefill-step-size 2048
)

if [[ -n "$CHAT_ARGS" ]]; then
  ARGS+=(--chat-template-args "$CHAT_ARGS")
fi

exec mlx_lm.server "${ARGS[@]}"
