#!/usr/bin/env bash
# llm-up - start a single mlx_lm.server in the background with the chosen profile.
# Usage: llm-up [profile]   default = server.default_profile in config/llm-dash.toml
#        (list the profiles: llm-serve list)
#
# Only one model at a time fits in 32 GB of RAM.
# To change model: llm-switch <profile>
# To stop: llm-down

set -euo pipefail

SCRIPT_DIR="$(python3 -c 'import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}")"
PROFILE="${1:-$(python3 "$SCRIPT_DIR/_config.py" server default_profile)}"

# Stop the previous server, if any.
if pgrep -f "mlx_lm.server" >/dev/null; then
  echo "stopping the previous mlx_lm.server..."
  pkill -f "mlx_lm.server" 2>/dev/null || true
  sleep 2
fi

if command -v tmux >/dev/null && [[ "${LLM_NO_TMUX:-0}" != "1" ]]; then
  tmux kill-session -t llm 2>/dev/null || true
  tmux new-session -d -s llm -n server "llm-serve $PROFILE"
  echo "Server '$PROFILE' started in tmux session 'llm' (port 1234)"
  echo "Logs:  tmux attach -t llm"
  echo "Stop:  llm-down"
else
  nohup llm-serve "$PROFILE" > "/tmp/llm-${PROFILE}.log" 2>&1 &
  disown -a
  echo "Server '$PROFILE' started in the background (port 1234)"
  echo "Logs:  tail -f /tmp/llm-${PROFILE}.log"
fi
