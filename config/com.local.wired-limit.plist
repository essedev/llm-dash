<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.local.wired-limit.plist
  Sets iogpu.wired_limit_mb to 28000 (28 GB) at every boot.
  Needed on macOS Tahoe so MLX can keep large models wired
  without paging out during decode.

  Install:
    sudo cp config/com.local.wired-limit.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/com.local.wired-limit.plist
    sudo chmod 644 /Library/LaunchDaemons/com.local.wired-limit.plist
    sudo launchctl load -w /Library/LaunchDaemons/com.local.wired-limit.plist

  Verify:      sysctl iogpu.wired_limit_mb
  Disable:     sudo launchctl unload /Library/LaunchDaemons/com.local.wired-limit.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.wired-limit</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/sbin/sysctl</string>
        <string>iogpu.wired_limit_mb=28000</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardErrorPath</key>
    <string>/var/log/wired-limit.log</string>
    <key>StandardOutPath</key>
    <string>/var/log/wired-limit.log</string>
</dict>
</plist>
